{
  "name": "bem-fteic-front-end",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "start": "next start",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "validate": "pnpm check && pnpm typecheck && pnpm test",
    "prepare": "husky install",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "clsx": "^2.1.0",
    "cssnano": "^8.0.2",
    "lucide-react": "^0.574.0",
    "next": "16.2.11",
    "next-sitemap": "^4.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.83.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.1.0",
    "tailwind-merge": "^2.2.2",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.0.1",
    "husky": "^8.0.3",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.2.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.25",
    "scheduler": "^0.23.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@babel/runtime": "7.29.7",
      "postcss": "8.5.25",
      "sharp": "0.35.0"
    }
  }
}
